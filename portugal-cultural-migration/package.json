{
  "name": "portugal-cultural-migration",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm --prefix apps/web run dev -- --host 0.0.0.0",
    "web:build": "npm --prefix apps/web run build",
    "mobile": "npm --prefix apps/mobile run start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:ios": "npm --prefix apps/mobile run ios"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  }
}
